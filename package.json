{
  "name": "@local-hosting/frames",
  "version": "0.1.0",
  "private": true,
  "description": "CompactFrame codecs + symbol-table expand/compress (thin-pipe frames).",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "import": "./dist/link/index.js",
      "default": "./dist/link/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "demo"
  ],
  "scripts": {
    "prebuild": "yarn workspace @local-hosting/comms build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts"
  },
  "dependencies": {
    "@local-hosting/comms": "0.3.0"
  },
  "devDependencies": {
    "@local-hosting/compose": "0.1.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@westlane/pino-blanc": "github:westlane/pino-blanc#v0.1.5",
    "buffer": "^6.0.3",
    "js-yaml": "^4.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}